<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Camera permission for Locket feature -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Storage permissions for gallery access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- CRITICAL: Required to read GPS location from photo EXIF data -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    
    <!-- Location permissions for Distance feature -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- Health Connect permissions for Sleep Tracking -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    
    <!-- Activity Recognition for Google Sleep API -->
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    
    <!-- Foreground service permission for location tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Required for high-priority FCM messages to wake device from Doze -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- For receiving FCM even when app is killed -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CoupleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoupleApp">
        
        <!-- Google Maps API Key - Replace with your actual API key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        
        <!-- Health Connect Client -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
            
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CoupleApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sleep Widget Provider -->
        <receiver
            android:name=".widget.SleepWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.coupleapp.WIDGET_CLICK" />
                <action android:name="com.example.coupleapp.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_widget_info" />
        </receiver>
        
        <!-- Locket Widget Provider -->
        <receiver
            android:name=".widget.LocketWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.coupleapp.LOCKET_WIDGET_CLICK" />
                <action android:name="com.example.coupleapp.UPDATE_LOCKET_WIDGET" />
                <action android:name="com.example.coupleapp.SEND_LOCKET_FROM_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/locket_widget_info" />
        </receiver>
        
        <!-- Missing Widget Provider -->
        <receiver
            android:name=".widget.MissingWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.coupleapp.MISSING_WIDGET_CLICK" />
                <action android:name="com.example.coupleapp.UPDATE_MISSING_WIDGET" />
                <action android:name="com.example.coupleapp.SEND_MISSING_FROM_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/missing_widget_info" />
        </receiver>
        
        <!-- Location Widget Provider -->
        <receiver
            android:name=".widget.LocationWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.coupleapp.LOCATION_WIDGET_CLICK" />
                <action android:name="com.example.coupleapp.UPDATE_LOCATION_WIDGET" />
                <action android:name="com.example.coupleapp.SHARE_LOCATION_FROM_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/location_widget_info" />
        </receiver>
        
        <!-- Widget Broadcast Receiver for system events -->
        <receiver
            android:name=".widget.receiver.WidgetBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.coupleapp.widget.UPDATE_SLEEP" />
                <action android:name="com.example.coupleapp.widget.UPDATE_LOCKET" />
                <action android:name="com.example.coupleapp.widget.UPDATE_MISSING" />
                <action android:name="com.example.coupleapp.widget.UPDATE_LOCATION" />
                <action android:name="com.example.coupleapp.widget.UPDATE_ALL" />
                <action android:name="com.example.coupleapp.widget.NEW_LOCKET" />
                <action android:name="com.example.coupleapp.widget.NEW_MISSING" />
                <action android:name="com.example.coupleapp.widget.LOCATION_CHANGED" />
            </intent-filter>
        </receiver>
        
        <!-- Google Sleep API Receiver -->
        <receiver
            android:name=".receiver.SleepReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.location.activity.SLEEP_SEGMENT" />
                <action android:name="com.google.android.gms.location.activity.SLEEP_CLASSIFY" />
            </intent-filter>
        </receiver>
        
        <!-- Significant Location Change Receiver (Battery-efficient like Widgetable) -->
        <receiver
            android:name=".service.SignificantLocationReceiver"
            android:enabled="true"
            android:exported="false" />
        
        <!-- Smart Geofence Receiver (for important places like Home/Work) -->
        <receiver
            android:name=".service.GeofenceReceiver"
            android:enabled="true"
            android:exported="false" />
            
        <!-- Location Restart Receiver - ensures tracking restarts after boot/update/clear RAM -->
        <receiver
            android:name=".receiver.LocationRestartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        
        <!-- Location Alarm Receiver - periodic fallback for reliable location updates -->
        <receiver
            android:name=".receiver.LocationAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        
        <!-- Sleep Alarm Receiver - Layer 3 for reliable sleep sync (survives Doze mode) -->
        <receiver
            android:name=".receiver.SleepAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        
        <!-- Widget Debug Receiver - for testing and diagnostics -->
        <receiver
            android:name=".widget.debug.WidgetDebugReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.coupleapp.DEBUG_WIDGETS" />
            </intent-filter>
        </receiver>
        
        <!-- Location Tracking Foreground Service -->
        <service
            android:name=".service.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
            
        <!-- 
            Unified Firebase Cloud Messaging Service
            IMPORTANT: Only ONE FCM service can receive messages!
            This service handles BOTH:
            - Silent Push (Data Messages) for background sync
            - Notification Messages for user alerts
        -->
        <service
            android:name=".service.UnifiedFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        
        <!-- Data Sync Foreground Service (for expedited work on Android 12+) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
            
        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>