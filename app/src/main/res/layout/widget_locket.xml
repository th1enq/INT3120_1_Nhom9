<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/locket_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Content container (shown when there's data) -->
    <LinearLayout
        android:id="@+id/locket_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Top: Content display area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Emoji content -->
            <TextView
                android:id="@+id/locket_emoji_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="❤️"
                android:textSize="40sp"
                android:visibility="gone" />

            <!-- Text content -->
            <TextView
                android:id="@+id/locket_text_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="I love you!"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="italic"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="visible"
                android:padding="4dp" />

            <!-- Image content (placeholder) -->
            <ImageView
                android:id="@+id/locket_image_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/locket"
                android:visibility="gone"
                android:contentDescription="Locket image" />

            <!-- Caption overlay at bottom -->
            <TextView
                android:id="@+id/locket_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#80000000"
                android:padding="2dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Bottom: Sender info and Send button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <!-- Locket icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/locket"
                android:contentDescription="Locket" />

            <!-- Sender and time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/locket_sender_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partner"
                    android:textColor="#9C27B0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/locket_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30"
                    android:textColor="#888888"
                    android:textSize="8sp" />

            </LinearLayout>

            <!-- Send button -->
            <TextView
                android:id="@+id/locket_send_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/circle_pink_background"
                android:gravity="center"
                android:text="📷"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Empty state container -->
    <LinearLayout
        android:id="@+id/locket_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/locket"
            android:alpha="0.5"
            android:contentDescription="No Locket" />

        <TextView
            android:id="@+id/locket_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chưa có Locket"
            android:textColor="#888888"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Nhấn để gửi"
            android:textColor="#9C27B0"
            android:textSize="9sp" />

    </LinearLayout>

</RelativeLayout>
