<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Header with Icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/sleep_tracker"
                android:contentDescription="@string/feature_sleep" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/feature_sleep"
                android:textColor="#5C6BC0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Hidden date header for backward compatibility -->
            <TextView
                android:id="@+id/sleep_date_header"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Comparison Row (Compact) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left User (Me) -->
            <LinearLayout
                android:id="@+id/left_user_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Status Icon -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    
                    <ImageView
                        android:id="@+id/left_progress_bg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/sleep_status" />
                    
                    <ImageView
                        android:id="@+id/left_status_circle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/excellent"
                        android:background="@drawable/circle_image_background"
                        android:clipToOutline="true"
                        android:contentDescription="@string/sleep_status" />
                </FrameLayout>

                <!-- Emoji -->
                <TextView
                    android:id="@+id/left_emoji_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="😊"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/left_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7h30"
                    android:textColor="#2D2D2D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/left_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xuất sắc"
                    android:textColor="#4CAF50"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/left_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn"
                    android:textColor="#666666"
                    android:textSize="7sp" />

                <!-- Hidden legacy field -->
                <TextView
                    android:id="@+id/left_date_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- VS Divider -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#9C27B0" />

                <TextView
                    android:id="@+id/achievement_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Right User (Partner) -->
            <LinearLayout
                android:id="@+id/right_user_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Status Icon -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/right_progress_bg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/sleep_status" />

                    <ImageView
                        android:id="@+id/right_status_circle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_image_background"
                        android:clipToOutline="true"
                        android:contentDescription="@string/sleep_status"
                        android:src="@drawable/good" />
                </FrameLayout>

                <!-- Emoji -->
                <TextView
                    android:id="@+id/right_emoji_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="🥦"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/right_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6h45"
                    android:textColor="#2D2D2D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/right_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốt"
                    android:textColor="#FF9800"
                    android:textSize="8sp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/right_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NY"
                    android:textColor="#666666"
                    android:textSize="7sp"
                    android:maxLines="1" />

                <!-- Hidden legacy field -->
                <TextView
                    android:id="@+id/right_date_text"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom: Goal (compact) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/sleep_goal_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 8h"
                android:textColor="#666666"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/bedtime_goal_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🌙 22:00"
                android:textColor="#5C6BC0"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bedtime Reminder Overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/bedtime_reminder_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#2C3E5F"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_time_to_sleep"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/bedtime_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="22:00"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Empty/Loading State -->
    <LinearLayout
        android:id="@+id/sleep_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/sleep_tracker"
            android:alpha="0.5"
            android:contentDescription="@string/feature_sleep" />

        <TextView
            android:id="@+id/sleep_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chưa có dữ liệu"
            android:textColor="#888888"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chạm để theo dõi"
            android:textColor="#5C6BC0"
            android:textSize="9sp" />
    </LinearLayout>
</RelativeLayout>
