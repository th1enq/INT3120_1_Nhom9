{
  "rules": {
    "chats": {
      "$coupleId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          ".indexOn": ["timestamp"],
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'message', 'messageType', 'timestamp', 'isRead'])"
          }
        }
      }
    }
  }
}
