rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Sleep records
    match /sleep_records/{recordId} {
      allow read, write: if request.auth != null;
    }
    
    // Sleep settings
    match /sleep_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Couple locations
    match /couple_locations/{coupleId} {
      allow read, write: if request.auth != null;
      
      match /user_locations/{userId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Locket posts
    match /locket_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || 
         request.auth.uid == resource.data.receiverId);
    }
    
    // Missing records
    match /missing_records/{recordId} {
      allow read, write: if request.auth != null;
    }
    
    // Sync triggers (for client-side push alternative to Cloud Functions)
    match /sync_triggers/{triggerId} {
      // Anyone authenticated can read triggers targeted at them
      allow read: if request.auth != null && 
        resource.data.targetUserId == request.auth.uid;
      // Anyone authenticated can create triggers
      allow create: if request.auth != null;
      // Only target user can update (mark as processed)
      allow update: if request.auth != null && 
        resource.data.targetUserId == request.auth.uid;
      // Target user or sender can delete
      allow delete: if request.auth != null && 
        (resource.data.targetUserId == request.auth.uid || 
         resource.data.senderId == request.auth.uid);
    }
    
    // Couples collection (for sleep records structure)
    match /couples/{coupleId} {
      allow read, write: if request.auth != null;
      
      match /sleep_records/{recordId} {
        allow read, write: if request.auth != null;
      }
      
      match /locations/{userId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // FCM tokens
    match /fcm_tokens/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
